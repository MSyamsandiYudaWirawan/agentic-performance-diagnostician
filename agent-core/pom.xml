<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.diag</groupId>
        <artifactId>diagnostician-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent-core</artifactId>
    <name>agent-core</name>
    <description>Spring AI agent loop: tools, prompt, ledger, keep/revert (keep-rule v2),
        guardrails, resume (scope §4.1-4.2).</description>

    <dependencies>
        <dependency>
            <groupId>io.diag</groupId>
            <artifactId>evidence</artifactId>
        </dependency>
        <dependency>
            <groupId>io.diag</groupId>
            <artifactId>target-runner</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- §10.8: Anthropic starter pointed at Z.AI's Anthropic-protocol endpoint.
             The monthly/coding plan funds /api/anthropic ONLY — the OpenAI-protocol
             endpoint (paas/v4) has a separate wallet (429 for plan users; measured
             2026-09-22). Tool-calling reliability is the selection criterion. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
