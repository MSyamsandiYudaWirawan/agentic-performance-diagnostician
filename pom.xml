<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.diag</groupId>
  <artifactId>diagnostician-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>agentic-performance-diagnostician</name>
  <description>AI agent that diagnoses Java/Spring performance bottlenecks, applies one fix
    per iteration, and proves improvement with benchmarks. See docs/.</description>

  <modules>
    <module>evidence</module>
    <module>target-runner</module>
    <module>agent-core</module>
    <module>eval</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <spring-boot.version>4.1.1</spring-boot.version>
    <!-- Spring AI: decision checkpoint at build step 8 (scope §10.8) — set the
         real version and import the BOM in agent-core when wiring tools. The
         property lives here so the version is declared in exactly one place. -->
    <spring-ai.version>SET-AT-STEP-8</spring-ai.version>
    <!-- Spring Data resolves named :params on repository methods by reflection
         on parameter names — requires javac -parameters (spring-boot-starter-parent
         normally sets this; we don't extend it) -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
    <!-- Boot 4 BOM manages spring-boot-testcontainers but NOT org.testcontainers
         modules — pin the BOM here so test-scope containers resolve in one place -->
    <testcontainers.version>1.20.6</testcontainers.version>
    <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- internal modules: evidence <- target-runner <- agent-core; eval on top -->
      <dependency>
        <groupId>io.diag</groupId>
        <artifactId>evidence</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.diag</groupId>
        <artifactId>target-runner</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.diag</groupId>
        <artifactId>agent-core</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
